{
  "name": "hcdc-rrt",
  "private": true,
  "description": "HCDC Rapid Response Team (RRT) webapp — Trung tâm Kiểm soát Bệnh tật TP.HCM",
  "scripts": {
    "start": "servor --reload",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "test:rls": "bash supabase/tests/run.sh",
    "check": "npm run lint && npm test",
    "check:schema": "node tools/check-supabase-schema.js",
    "check:rls": "node tools/check-rls.js",
    "e2e": "node tests/e2e/smoke.js",
    "e2e:recovery": "node tests/e2e/password-recovery.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "servor": "^4.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0"
  }
}
